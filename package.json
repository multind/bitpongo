{
  "name": "zhitoubaofront",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint:eslint": "eslint --cache --max-warnings 0  \"{src,mock}/**/*.{vue,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write  \"src/**/*.{js,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:lint-staged": "lint-staged",
    "prepare": "husky install",
    "deps": "yarn upgrade-interactive --latest",
    "commit": "git add . && git-cz"
  },
  "dependencies": {
    "@nutui/icons-vue": "^0.1.1",
    "@nutui/nutui": "^4.3.14",
    "@varlet/ui": "^3.20.3",
    "@vueuse/core": "14.4.0",
    "@vueuse/integrations": "14.4.0",
    "axios": "1.19.0",
    "chart.js": "^4.5.1",
    "cron-parser": "^5.10.0",
    "dayjs": "^1.11.21",
    "html2canvas": "^1.4.1",
    "luxon": "^3.7.2",
    "mitt": "^3.0.1",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "universal-cookie": "^8.1.2",
    "vant": "^4.10.0",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nutui/auto-import-resolver": "^1.0.0",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vant/auto-import-resolver": "^1.3.0",
    "@varlet/import-resolver": "^3.20.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "@zhaojjiang/vite-plugin-eruda": "^0.0.5",
    "amfe-flexible": "^2.2.1",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "^2.11.14",
    "cnjm-postcss-px-to-viewport": "^1.0.1",
    "consola": "^3.4.2",
    "cross-env": "^10.1.0",
    "cz-git": "^1.13.2",
    "czg": "^1.13.2",
    "eruda": "^3.4.3",
    "eslint": "^10.8.1",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "git-cz": "^4.9.0",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "17.3.0",
    "mockjs": "^1.1.0",
    "node": "^26.7.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "postcss-html": "2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.2.0",
    "terser": "^5.50.0",
    "typescript": "5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-pages": "^0.33.3",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-qrcode": "^0.4.1",
    "vite-plugin-restart": "^2.0.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-setup-extend-plus": "^0.1.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.12.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "resolutions": {
    "bin-wrapper": "npm:bin-wrapper-china",
    "gifsicle": "5.2.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{!(package)*.json,*.code-snippets,.!(browserslist)*rc}": [
      "prettier --write--parser json"
    ],
    "package.json": [
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{scss,less,styl,html}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "type": "module"
}
